# 章節小冊專用設定。
# 這份設定給「單章節、A4 雙面列印、對折騎馬釘」用。

# 中文正文主字體。
CJK_MAINFONT="Songti SC"

# 同上：拉丁／等寬；留空時與 pandoc 預設（Latin Modern）相同，Unicode 下角標會缺字。
LATIN_MAINFONT="Lucida Grande"
LATIN_MONOFONT="Menlo"

# 正文字級。
FONT_SIZE="12pt"

# A5 成品尺寸。
PAPER_WIDTH="148mm"
PAPER_HEIGHT="210mm"

# 邊界設定。
INNER_MARGIN="14mm"
OUTER_MARGIN="10mm"
TOP_MARGIN="12mm"
BOTTOM_MARGIN="12mm"

# 章節小冊先不要自動產生目錄。
# 否則像 IV 章這種短章，前面會多出目錄頁，看起來像多了一張空白頁。
INCLUDE_TOC="0"
