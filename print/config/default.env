# 這是給 scripts/build_print_pdf.sh 使用的 PDF 版面設定檔。
#
# 單位說明：
# - 紙張尺寸、邊界：mm
# - 字體大小：pt
#
# 目前這組設定，就是先前輸出這份 50 頁 PDF 時用的參數：
# out/ctci-vol1-frontmatter-a5.pdf

# 中文正文主字體。
# 目前使用 macOS 內建的宋體 Songti SC。
CJK_MAINFONT="Songti SC"

# 拉丁文正文與等寬（對應 pandoc `-V mainfont` / `-V monofont`）。
# Latin Modern（pandoc 預設）不含 log₂（U+2082）等 Unicode 下角標，會刷屏 Missing character。
# macOS：Lucida Grande + Menlo 可涵蓋常見標點與數學排版字元；請留空停用（恢復 pandoc/LM）。
# Linux：請改用本機已有的「Noto Serif」等並 `fc-match` / `fc-list : family` 對名稱，
#       或使用 `dnf install google-noto-sans-*`／`fonts-noto` 後將下面兩項改成對應名稱。
LATIN_MAINFONT="Lucida Grande"
LATIN_MONOFONT="Menlo"

# 正文字級。
FONT_SIZE="12pt"

# --------------------------------------------------
# 目前啟用：A5
# A5 比一般 A4 講義更接近書本尺寸，適合現在這個專案。
# 如果你要改成 A4 或 A6：
# 1. 先把下面這組保留或註解掉
# 2. 再去把對應區塊取消註解
# --------------------------------------------------
PAPER_WIDTH="148mm"
PAPER_HEIGHT="210mm"

# 邊界設定。
# 這裡我先改成比較省空間的版本，讓每頁能放更多內容。
# 如果之後覺得太擠，再往上加回去即可。
INNER_MARGIN="14mm"
OUTER_MARGIN="10mm"
TOP_MARGIN="12mm"
BOTTOM_MARGIN="12mm"

# --------------------------------------------------
# A4 預設
# 比較像講義或在家用印表機直接列印的尺寸。
# 要使用時，請把下面這組前面的 # 拿掉，
# 再把上面的 A5 那組改掉或註解掉。
# --------------------------------------------------
# PAPER_WIDTH="210mm"
# PAPER_HEIGHT="297mm"
# INNER_MARGIN="22mm"
# OUTER_MARGIN="18mm"
# TOP_MARGIN="20mm"
# BOTTOM_MARGIN="20mm"

# --------------------------------------------------
# A6 預設
# 尺寸更小，會更像口袋書，但同樣內容頁數會增加很多。
# 要使用時，請把下面這組前面的 # 拿掉，
# 再把上面的 A5 那組改掉或註解掉。
# --------------------------------------------------
# PAPER_WIDTH="105mm"
# PAPER_HEIGHT="148mm"
# INNER_MARGIN="14mm"
# OUTER_MARGIN="10mm"
# TOP_MARGIN="14mm"
# BOTTOM_MARGIN="14mm"
